# Catppuccin Mocha, matching the quickshell bar theme
# (~/.config/quickshell/bar/theme/Colors.qml, PillWidget.qml)

font=JetBrainsMono Nerd Font Propo 11

background-color=#1e1e2eFF
text-color=#cdd6f4FF
border-color=#89b4faFF
border-size=2
border-radius=0
progress-color=over #89b4faFF

width=320
padding=10,15
margin=10
outer-margin=50,10,10,10

icon-location=left
max-icon-size=48

anchor=top-right
default-timeout=5000

[urgency=critical]
border-color=#f38ba8FF
default-timeout=0
